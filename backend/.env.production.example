# HeartChain Backend - 生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# App
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database (云数据库连接)
DB_HOST=your-db-host.cloudprovider.com
DB_PORT=5432
DB_USERNAME=heartchain_prod
DB_PASSWORD=【生产数据库密码】
DB_DATABASE=heartchain

# JWT (使用更复杂的密钥)
JWT_SECRET=【随机生成的64位密钥】
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=【随机生成的64位密钥】
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=【Redis密码】

# SMS (阿里云短信)
SMS_ACCESS_KEY_ID=【阿里云AK】
SMS_ACCESS_KEY_SECRET=【阿里云SK】
SMS_SIGN_NAME=哈特链
SMS_TEMPLATE_CODE=【短信模板CODE】

# Push (极光推送)
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# OSS (阿里云OSS)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Blockchain
POLYGON_RPC_URL=
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

SUBSTRATE_WS_URL=

DEFAULT_REGION=cn
