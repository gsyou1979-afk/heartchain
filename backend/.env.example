# HeartChain Backend Environment Config

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (SQLite for local dev / PostgreSQL for production)
DB_PATH=./heartchain.sqlite
DATABASE_URL=

# Legacy PostgreSQL config (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=heartchain
DB_PASSWORD=heartchain_dev_2026
DB_DATABASE=heartchain

# JWT
JWT_SECRET=heartchain_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=heartchain_refresh_secret_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMS (Aliyun)
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=哈特链
SMS_TEMPLATE_CODE=

# Push (JPush)
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# OSS
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Blockchain - Polygon zkEVM
# Testnet: https://rpc.public.zkevm-testnet.com (Chain ID: 1442)
# Mainnet: https://zkevm-rpc.com (Chain ID: 1101)
BLOCKCHAIN_RPC_URL=https://rpc.public.zkevm-testnet.com
ADMIN_PRIVATE_KEY=
HRT_CONTRACT_ADDRESS=
TASK_CONTRACT_ADDRESS=

# Legacy Polygon (备选)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

# Substrate (Compliance Chain - China)
SUBSTRATE_WS_URL=ws://localhost:9944

# Region: cn / kr / global
DEFAULT_REGION=kr
