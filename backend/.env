# HeartChain Backend Environment Config

# App
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=heartchain

# JWT
JWT_SECRET=heartchain_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=heartchain_refresh_secret_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMS (Aliyun) - 生产环境必填
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=哈特链
SMS_TEMPLATE_CODE=

# Push (JPush)
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# OSS
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Blockchain
# Polygon (Public Chain - Korea/International)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

# Substrate (Compliance Chain - China)
SUBSTRATE_WS_URL=ws://localhost:9944

# Region: cn / kr / global
DEFAULT_REGION=cn

# ============================================
# 生产环境部署时:
# 1. NODE_ENV=production
# 2. 设置生产数据库连接
# 3. 填写所有必填的配置
# 4. 运行: npm run migration:run
# ============================================
