{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": ["./hardhat.config.ts", "./scripts/**/*.ts", "./test/**/*.ts", "./contracts/**/*.sol"],
  "exclude": ["node_modules", "dist", "cache", "artifacts"]
}
